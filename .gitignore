# Local development credentials (see docs/credentials/README.md and .claude/rules/40-security.md)
docs/credentials/*
!docs/credentials/README.md

# Local Claude Code permission overrides (machine-specific, not shared)
.claude/settings.local.json

# docs/original-docs/ commonly receives real personal financial exports (brokerage
# CSV/PDF/Excel, account screenshots, etc.) dropped in ad hoc during requirements
# gathering. Default-deny everything there and only allow the reviewed Markdown
# reference docs, instead of chasing each risky extension individually.
docs/original-docs/*
!docs/original-docs/*.md

# Laravel application (scaffolded via docs/adr/ADR-0001-frontend-stack-selection.md)
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
